# ===================================
# MOREMI API — ENVIRONMENT VARIABLES
# ===================================
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# ===================================
# API SECURITY
# ===================================
API_KEY=your_secret_api_key_here
NODE_ENV=development

# ===================================
# FIREBASE CONFIGURATION
# ===================================
FIREBASE_PROJECT_ID=your-firebase-project-id
# Paste your entire Firebase service account JSON as a single line string
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Firestore: (default) or a named database ID (must match docs/site-config.js __MOREMI_FIRESTORE_DATABASE_ID__)
FIRESTORE_DATABASE_ID=(default)

# ===================================
# FIRESTORE / MAP (optional)
# ===================================
# FIRMS_MAP_KEY=...  # if using fire check features

# ===================================
# SERVER SETTINGS
# ===================================
PORT=3000
